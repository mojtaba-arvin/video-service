# Copy this file to .env and replace the placeholders for your environment.
# Never commit the resulting .env file.

# Durable workflow state (PostgreSQL; persistent source of truth)
WORKFLOW_DATABASE_URL=postgresql+psycopg2://video:replace-me@workflow-db:5432/video_workflows
WORKFLOW_DATABASE_POOL_SIZE=5
WORKFLOW_DATABASE_MAX_OVERFLOW=5

# Optional immutable infrastructure price card. Set both ID and version;
# incomplete cards fail closed. Blank values select the non-monetary RUNIT model.
WORKFLOW_PRICING_MODEL_ID=
WORKFLOW_PRICING_MODEL_VERSION=
WORKFLOW_COST_CURRENCY=USD
WORKFLOW_CPU_COST_PER_SECOND=0
WORKFLOW_MEMORY_GB_SECOND_COST=0
WORKFLOW_STORAGE_GB_COST=0

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
TASK_RETRY_BACKOFF_MAX=10
TASK_RETRY_FFMPEG_COMMAND_MAX=1
WEBHOOK_CONNECT_TIMEOUT_SECONDS=3
WEBHOOK_READ_TIMEOUT_SECONDS=10
# Enable only for isolated local tests; production must keep this false.
WEBHOOK_ALLOW_LOOPBACK_CALLBACKS=False

# Playlist and encoding defaults
DEFAULT_PLAYLIST_IS_HLS=True
DEFAULT_SEGMENT_TYPE_IS_FMP4=True
DONT_REPLACE_OUTPUT=True
CREATE_OUTPUT_BUCKET=True
DEFAULT_ENCODE_FORMAT=h264

# S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION_NAME=us-east-1
S3_IS_SECURE=False
S3_DEFAULT_BUCKET=video
S3_DEFAULT_INPUT_BUCKET_NAME=video-input
S3_DEFAULT_OUTPUT_BUCKET_NAME=video-output
S3_TRANSFER_MULTIPART_THRESHOLD=8388608
S3_TRANSFER_MAX_CONCURRENCY=10
S3_TRANSFER_MULTIPART_CHUNKSIZE=8388608
S3_TRANSFER_NUM_DOWNLOAD_ATTEMPTS=5
S3_TRANSFER_MAX_IO_QUEUE=100
S3_TRANSFER_IO_CHUNKSIZE=262144
S3_TRANSFER_USE_THREADS=True

# Local work directories
TMP_DOWNLOADED_DIR=/tmp/downloaded_videos/
TMP_PROCESSED_DIR=/tmp/transcoded_videos/

# FFmpeg binaries
FFPROBE_BIN_PATH=/usr/local/bin/ffprobe
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_BIN_PATH=/usr/local/bin/ffmpeg
FFMPEG_THUMBNAIL_TIMEOUT_SECONDS=300
FFMPEG_WATERMARK_TIMEOUT_SECONDS=3600
PACKAGE_METADATA_PROBE_TIMEOUT_SECONDS=10

# Redis
REDIS_TIMEOUT_SECOND=86400
REDIS_URL=redis://localhost:6379/0
